{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COMPX Tray",
  "version": "0.1.0",
  "identifier": "io.github.brunovncs.compx-tray",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "COMPX Tray",
        "width": 440,
        "height": 800,
        "minWidth": 400,
        "minHeight": 560,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost https://api-hub-cloud.atk.pro"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
